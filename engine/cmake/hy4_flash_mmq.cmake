# Legacy CUDA MMQ for HY4-Flash GGUF. Other families use strata_pf_own.
set(_hy4_mmq src/hy4flash_gguf/mmq)
set(_hy4_ggml ${CMAKE_CURRENT_SOURCE_DIR}/third_party/strata-llama/ggml)
set(_hy4_cuda ${_hy4_ggml}/src/ggml-cuda)
add_library(strata_hy4_flash_mmq STATIC
    ${_hy4_mmq}/moe_mmq.cu ${_hy4_mmq}/ggml_cuda_host.cu
    ${_hy4_mmq}/mmq_kq_loader.cpp ${_hy4_mmq}/mmq_nvfp4_w4a8.cu ${_hy4_cuda}/quantize.cu)
add_library(strata_hy4_flash_w4a4 STATIC ${_hy4_mmq}/mmq_nvfp4_w4a4.cu)
add_library(strata_hy4_flash_kq SHARED ${_hy4_mmq}/mmq_kq_lib.cu ${_hy4_mmq}/ggml_cuda_host.cu)
set_target_properties(strata_hy4_flash_kq PROPERTIES OUTPUT_NAME strata_kq CUDA_RUNTIME_LIBRARY Static
    CXX_VISIBILITY_PRESET hidden CUDA_VISIBILITY_PRESET hidden)
set_target_properties(ggml-base PROPERTIES POSITION_INDEPENDENT_CODE ON)
foreach(_target IN ITEMS strata_hy4_flash_mmq strata_hy4_flash_w4a4 strata_hy4_flash_kq)
  target_include_directories(${_target} BEFORE PRIVATE ${_hy4_ggml}/include ${_hy4_ggml}/src ${_hy4_cuda}
      ${CMAKE_CURRENT_SOURCE_DIR}/include)
  target_compile_options(${_target} PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:--extended-lambda -use_fast_math>)
  if(MSVC)
    target_compile_options(${_target} PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-Xcompiler=/bigobj>)
  endif()
  target_link_libraries(${_target} PRIVATE ggml-base CUDA::cuda_driver)
endforeach()
set(_hy4_w4a4_archs ${CMAKE_CUDA_ARCHITECTURES})
if("native" IN_LIST _hy4_w4a4_archs AND CMAKE_CUDA_ARCHITECTURES_NATIVE)
  list(REMOVE_ITEM _hy4_w4a4_archs native)
  list(APPEND _hy4_w4a4_archs ${CMAKE_CUDA_ARCHITECTURES_NATIVE})
endif()
list(TRANSFORM _hy4_w4a4_archs REPLACE "^(12[0-9])$" "\\1a")
list(TRANSFORM _hy4_w4a4_archs REPLACE "^(12[0-9])-(real|virtual)$" "\\1a-\\2")
set_target_properties(strata_hy4_flash_w4a4 PROPERTIES CUDA_ARCHITECTURES "${_hy4_w4a4_archs}")
foreach(_type IN ITEMS q2_0 iq2_xxs iq2_xs iq2_s iq3_xxs iq3_s iq4_nl iq4_xs q8_0)
  target_sources(strata_hy4_flash_mmq PRIVATE ${_hy4_cuda}/template-instances/mmq-instance-${_type}.cu)
endforeach()
foreach(_type IN ITEMS q4_k q5_k q5_1 q6_k)
  target_sources(strata_hy4_flash_kq PRIVATE ${_hy4_cuda}/template-instances/mmq-instance-${_type}.cu)
endforeach()
target_compile_definitions(strata_hy4_flash_mmq PRIVATE STRATA_KQ_DSO=1 STRATA_MMQ_KQUANTS=1 STRATA_HY4_FLASH_MMQ_QUANTIZED_SUM=1
    INTERFACE STRATA_HY4_FLASH_MMQ=1)
target_link_libraries(strata_hy4_flash_mmq PRIVATE strata_hy4_flash_w4a4 CUDA::cudart ${CMAKE_DL_LIBS})
add_dependencies(strata_hy4_flash_mmq strata_hy4_flash_kq)
