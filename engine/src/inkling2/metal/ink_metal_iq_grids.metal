static inline ushort iq_ld16(device const uchar* p) {
    return ushort(p[0]) | (ushort(p[1]) << 8);
}

static inline uint iq_ld32(device const uchar* p) {
    return uint(p[0]) | (uint(p[1]) << 8) | (uint(p[2]) << 16) | (uint(p[3]) << 24);
}

