        const uint gi = uint(blk[2 + sub * 4 + l4]) | ((uint(qh) << (8u - 2u * uint(l4))) & 0x300u);
        const uchar sg = blk[34 + sub * 4 + l4];
        const float dl = d * (0.5f + float((sc >> (4 * (l4 >> 1))) & 15u)) * 0.25f;
        const ulong g = kMtlIq2SGrid[gi];
        const uint g0 = uint(g & 0xfffffffful), g1 = uint(g >> 32);
        w0 = float4(
            float((g0 >>  0) & 255u) * ((sg &   1u) ? -dl : dl),
            float((g0 >>  8) & 255u) * ((sg &   2u) ? -dl : dl),
            float((g0 >> 16) & 255u) * ((sg &   4u) ? -dl : dl),
            float((g0 >> 24) & 255u) * ((sg &   8u) ? -dl : dl));
        w1 = float4(
            float((g1 >>  0) & 255u) * ((sg &  16u) ? -dl : dl),
            float((g1 >>  8) & 255u) * ((sg &  32u) ? -dl : dl),
            float((g1 >> 16) & 255u) * ((sg &  64u) ? -dl : dl),
            float((g1 >> 24) & 255u) * ((sg & 128u) ? -dl : dl));
    } else if (t == 19u) {  // IQ1_S: 256 elems = 50 B
        const int b = col >> 8, idx = col & 255;
        device const uchar* blk = row + (size_t)b * 50ul;
        const float d = float(as_type<half>(iq_ld16(blk)));
        const int sub = idx >> 5, l4 = (idx & 31) >> 3;
        const ushort qh = iq_ld16(blk + 34 + sub * 2);
        const float dl = d * float(2 * int((qh >> 12) & 7u) + 1);
        const float delta = (qh & 0x8000u) ? -0.125f : 0.125f;
        const uint gi = uint(blk[2 + sub * 4 + l4]) | ((uint(qh >> uint(3 * l4)) & 7u) << 8);
        const ulong g = kMtlIq1SGrid[gi];
        const uint g0 = uint(g & 0xfffffffful), g1 = uint(g >> 32);
        w0 = float4(
            dl * (float(char((g0 >>  0) & 255u)) + delta),
            dl * (float(char((g0 >>  8) & 255u)) + delta),
            dl * (float(char((g0 >> 16) & 255u)) + delta),
            dl * (float(char((g0 >> 24) & 255u)) + delta));
        w1 = float4(
            dl * (float(char((g1 >>  0) & 255u)) + delta),
            dl * (float(char((g1 >>  8) & 255u)) + delta),
            dl * (float(char((g1 >> 16) & 255u)) + delta),
            dl * (float(char((g1 >> 24) & 255u)) + delta));
    } else {
        w0 = float4(0.0f); w1 = float4(0.0f);
    }
}
