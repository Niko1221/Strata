    # prompt-speed plan step 2b: llama.cpp's MMQ kernels for the GLM prompt path (upstream's method, CUDA)
    set(_strata_glm_gg ${STRATA_GGML_DIR}/ggml)
    set(_strata_glm_mmq_patch ${CMAKE_CURRENT_SOURCE_DIR}/third_party/ggml/mmq-fused-swiglu.patch)
    set(_strata_glm_mmq_copy ${CMAKE_BINARY_DIR}/strata-glm-ggml-cuda)
    file(SHA256 ${_strata_glm_mmq_patch} _strata_glm_mmq_patch_sha)
    file(SHA256 ${_strata_glm_gg}/src/ggml-cuda/mmq.cuh _strata_glm_mmq_src_sha)
    set(_strata_glm_mmq_stamp "${_strata_glm_gg}|${_strata_glm_mmq_src_sha}|${_strata_glm_mmq_patch_sha}")
    set(_strata_glm_mmq_glu ON)
    set(_strata_glm_mmq_done "")
    if(EXISTS ${_strata_glm_mmq_copy}/.strata-stamp)
      file(READ ${_strata_glm_mmq_copy}/.strata-stamp _strata_glm_mmq_done)
    endif()
    if(NOT _strata_glm_mmq_done STREQUAL _strata_glm_mmq_stamp)
      find_package(Git)
    endif()
    if(NOT _strata_glm_mmq_done STREQUAL _strata_glm_mmq_stamp AND NOT GIT_FOUND)
      message(WARNING "strata-glm: git not found for mmq-fused-swiglu.patch - the pinned MMQ sources are built as they are")
      set(_strata_glm_mmq_glu OFF)
    elseif(NOT _strata_glm_mmq_done STREQUAL _strata_glm_mmq_stamp)
      file(REMOVE_RECURSE ${_strata_glm_mmq_copy})
      file(COPY ${_strata_glm_gg}/src/ggml-cuda/ DESTINATION ${_strata_glm_mmq_copy})
      execute_process(COMMAND ${CMAKE_COMMAND} -E env GIT_CEILING_DIRECTORIES=${CMAKE_BINARY_DIR}
                              ${GIT_EXECUTABLE} apply --ignore-whitespace ${_strata_glm_mmq_patch}
                      WORKING_DIRECTORY ${_strata_glm_mmq_copy} RESULT_VARIABLE _glm_mmq_rc ERROR_VARIABLE _glm_mmq_err)
      if(_glm_mmq_rc EQUAL 0)
        file(WRITE ${_strata_glm_mmq_copy}/.strata-stamp "${_strata_glm_mmq_stamp}")
      else()
        message(WARNING "strata-glm: mmq-fused-swiglu.patch does not apply to ${_strata_glm_gg}/src/ggml-cuda - built as they are:\n${_glm_mmq_err}")
        file(REMOVE_RECURSE ${_strata_glm_mmq_copy})
        set(_strata_glm_mmq_glu OFF)
      endif()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_strata_glm_mmq_patch} ${_strata_glm_gg}/src/ggml-cuda/mmq.cuh)
    if(_strata_glm_mmq_glu)
      set(_glm_mmq ${_strata_glm_mmq_copy})
    else()
      set(_glm_mmq ${_strata_glm_gg}/src/ggml-cuda)
    endif()
    foreach(_t q2_0 iq2_xxs iq2_xs iq2_s iq3_xxs iq3_s iq4_nl iq4_xs q8_0 iq1_s q2_k q3_k q4_k q5_k q6_k)
      target_sources(strata_glm_impl PRIVATE ${_glm_mmq}/template-instances/mmq-instance-${_t}.cu)
    endforeach()
    target_sources(strata_glm_impl PRIVATE ${_glm_mmq}/quantize.cu ${_glm_mmq}/convert.cu)
    if(_strata_glm_mmq_glu)
      target_compile_definitions(strata_glm_impl PRIVATE STRATA_MMQ_GLU=1)
    endif()
    target_compile_definitions(strata_glm_impl PRIVATE STRATA_PREFILL_MMQ=1)
    target_compile_options(strata_glm_impl PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:--extended-lambda>)
    target_include_directories(strata_glm_impl PRIVATE ${_strata_glm_gg}/include ${_strata_glm_gg}/src ${_glm_mmq})
