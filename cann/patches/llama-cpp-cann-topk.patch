+void ggml_cann_top_k(ggml_backend_cann_context & ctx, ggml_tensor * dst) {
+    ggml_tensor * src = dst->src[0];
+    const int64_t k   = dst->ne[0];
+
+    acl_tensor_ptr acl_src = ggml_cann_create_tensor(src);
+    acl_tensor_ptr acl_dst = ggml_cann_create_tensor(dst);
+
+    // aclnnTopk wants i64 indices and always writes values too; both go to scratch buffers and
+    // the indices are cast down to the i32 that ggml_top_k produces, as argsort does
+    ggml_cann_pool_alloc idx_alloc(ctx.pool(), (size_t) ggml_nelements(dst) * sizeof(int64_t));
+    acl_tensor_ptr acl_idx = ggml_cann_create_tensor(idx_alloc.get(), ACL_INT64,
+            ggml_type_size(dst->type), dst->ne, dst->nb, GGML_MAX_DIMS);
+
+    ggml_cann_pool_alloc val_alloc(ctx.pool(),
+            (size_t) ggml_nelements(dst) * ggml_type_size(src->type));
+    acl_tensor_ptr acl_val = ggml_cann_create_tensor(val_alloc.get(),
+            ggml_cann_type_mapping(src->type), ggml_type_size(src->type),
+            dst->ne, dst->nb, GGML_MAX_DIMS);
+
+    // ggml reduces along dim 0, which is the last dim of the 4-D tensor CANN sees
+    GGML_CANN_CALL_ACLNN_OP(ctx, Topk, acl_src.get(), k, (int64_t) 3, true, false,
+            acl_val.get(), acl_idx.get());
+    GGML_CANN_CALL_ACLNN_OP(ctx, Cast, acl_idx.get(), ggml_cann_type_mapping(dst->type), acl_dst.get());
+}
