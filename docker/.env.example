# ============================================================================
# Strata Docker deployment — copy to .env and adjust
#   cp .env.example .env
# ============================================================================

# ---------- Public endpoint ----------
# HTTPS port clients connect to (other devices on the LAN)
STRATA_HTTPS_PORT=38888
# Host name written into the certificate. For LAN access use this machine's IP
# or a domain name, then regenerate the certificate (scripts/gen-cert.sh)
STRATA_HOST=localhost

# ---------- Model ----------
# One of: Q2_0 (fastest) / IQ2_XS / IQ3_XXS / IQ3_S (best quality)
#        IQ1_M (Coder, fits in 32 GB RAM) / UD-Q4_K_XL (experimental, needs lots of RAM)
MODEL=IQ3_S
# Context window, up to 262144 (256K). Lower it when VRAM is tight
CONTEXT=262144
# KV cache quantization: int8 (higher quality) / q4_0 (half the memory) / k8v4
KV=q4_0
# Image input: no / yes (GPU encoder) / cpu
VISION=yes

# ---------- Hardware ----------
# Compile only your GPU's CUDA architecture — much faster builds.
# RTX20=75 / RTX30=86 / RTX40=89 / RTX50=120 / A-series=80
# Combine with semicolons, e.g. "86;89;120"
CUDA_ARCHITECTURES=89
# Multiple GPUs: GPUS=0,1   (single GPU: GPU=0; leave empty for auto)
# GPU=
# GPUS=
# Expert low-RAM mode when system RAM is constrained: auto / on / off
LOW_RAM=auto

# ---------- Data and mirrors ----------
# Where models and configs are stored (host path; use forward slashes on
# Windows, e.g. D:/data/strata). Leave empty to use the named volume strata-data.
# STRATA_DATA_DIR=D:/data/strata

# HuggingFace mirror. Useful behind a restrictive network; empty = upstream default.
HF_ENDPOINT=https://hf-mirror.com

# ---------- Management console ----------
# Metric retention in days
KEEP_DAYS=7
# System metric sampling interval (seconds)
SAMPLE_INTERVAL=10

# ---------- Optional overrides for restricted networks ----------
# When docker.io is unreachable, point the base image at a mirror (pick one):
# BASE_IMAGE=docker.1ms.run/library/python:3.12-slim
# And a PyPI mirror:
# PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
