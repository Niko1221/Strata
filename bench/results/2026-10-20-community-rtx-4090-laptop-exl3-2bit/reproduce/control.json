{
  "exe": "<DATA_DIR>/Strata-EXL3-tuning/build/strata",
  "args": [
    "--exl3",
    "<DATA_DIR>/ExLlamaV3-Qwen-SC/models/Qwen3.8-Flash-Next-2.05bpw_h8",
    "--ple-exl3",
    "<DATA_DIR>/ExLlamaV3-Qwen-SC/models/Qwen3.8-Flash-Next-2.05bpw_h8/ngram_embedding.safetensors",
    "--exl3-lane",
    "--pool-workers",
    "10",
    "--exl3-lane-profile",
    "<DATA_DIR>/Strata-new/data/expert-profile.bin",
    "--exl3-vram-tier",
    "6757",
    "--prefill",
    "auto:1024",
    "--max-context",
    "65536",
    "--kv",
    "int8",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--mtp",
    "<DATA_DIR>/Strata-data/mtp/rt"
  ],
  "cwd": "<DATA_DIR>/Strata-EXL3-tuning/source",
  "tokenizer": "<DATA_DIR>/Strata-EXL3-test/pack/tokenizer",
  "model_name": "qwen3.8-flash-next-exl3-sc-2.05-h8",
  "env": {
    "CUDA_VISIBLE_DEVICES": "0",
    "PYTHONDONTWRITEBYTECODE": "1",
    "TMPDIR": "<DATA_DIR>/Strata-EXL3-tuning/tmp",
    "XDG_CACHE_HOME": "<DATA_DIR>/Strata-EXL3-tuning/cache",
    "STRATA_EXL3_DENSE": "q8",
    "STRATA_ROUTE_TAIL_SKIP": "0",
    "CUDA_CACHE_PATH": "<DATA_DIR>/Strata-EXL3-tuning/cache/cuda",
    "TORCH_EXTENSIONS_DIR": "<DATA_DIR>/Strata-EXL3-tuning/cache/torch",
    "TRITON_CACHE_DIR": "<DATA_DIR>/Strata-EXL3-tuning/cache/triton"
  },
  "host": "127.0.0.1",
  "port": 8091,
  "log": "<DATA_DIR>/Strata-EXL3-tuning/logs/control-engine.log"
}
