-import {Repository} from './repository.ts';
-import {parseItems} from './validation.ts';
+import {Repository, type Order} from './repository.ts';
+import {parseItems, computeTotal, normalizeItems, ValidationError, type Item} from './validation.ts';
+
+export type CreateResult = {status:number; order:Order | undefined};
+
 export class OrderService {
-  repo:Repository; constructor(repo:Repository) { this.repo=repo; }
-  async create(key:string, body:any) { const items=parseItems(body.items); return {status:201,order:await this.repo.insert(items,0)}; }
+  repo:Repository;
+  pending:Map<string, Promise<CreateResult>> = new Map();
+  constructor(repo:Repository) { this.repo=repo; }
+
+  async create(key:string, body:any): Promise<CreateResult> {
+    if (typeof key !== 'string' || key.length === 0) {
+      throw new ValidationError('idempotency-key must be nonempty');
+    }
+    const items:Item[] = parseItems(body && body.items);
+    const payload = normalizeItems(items);
+    const total = computeTotal(items);
+
+    const existing = this.repo.findByKey(key);
+    if (existing) {
+      if (existing.payload === payload) return {status:200, order:existing.order};
+      return {status:409, order:undefined};
+    }
+
+    const inFlight = this.pending.get(key);
+    if (inFlight) return inFlight;
+
+    const promise = this.commit(key, payload, items, total);
+    this.pending.set(key, promise);
+    try {
+      return await promise;
+    } finally {
+      this.pending.delete(key);
+    }
+  }
+
+  private async commit(key:string, payload:string, items:Item[], total:number): Promise<CreateResult> {
+    const order = await this.repo.insert(key, payload, items, total);
+    return {status:201, order};
+  }
 }
