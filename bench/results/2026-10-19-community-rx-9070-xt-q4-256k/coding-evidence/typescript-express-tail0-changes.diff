+test('service: normalized payload replay ignores key ordering differences',async()=>{const repo=new Repository();const s=new OrderService(repo);const a=await s.create('k',{items:[{sku:'a',quantity:1,unitPrice:10},{sku:'b',quantity:2,unitPrice:5}]});assert.equal(a.status,201);assert.equal(a.order.total,20);const b=await s.create('k',{items:[{sku:'a',quantity:1,unitPrice:10},{sku:'b',quantity:2,unitPrice:5}]});assert.equal(b.status,200);assert.deepEqual(a.order,b.order);assert.equal(repo.orders.length,1);});
