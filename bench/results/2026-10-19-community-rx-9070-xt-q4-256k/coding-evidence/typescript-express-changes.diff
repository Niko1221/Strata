+import test from 'node:test'; import assert from 'node:assert/strict';
+import {Repository} from './repository.ts'; import {OrderService} from './service.ts'; import {ValidationError} from './validation.ts'; import {app} from './server.ts';
+
+function svc(){return new OrderService(new Repository());}
+
+test('validation rejects bad payloads',async()=>{
+ const s=svc();
+ await assert.rejects(()=>s.create('k',{items:[]}),ValidationError);
+ await assert.rejects(()=>s.create('k',{items:'x'}),ValidationError);
+ await assert.rejects(()=>s.create('k',{items:[{sku:'a',quantity:0,unitPrice:1}]}),ValidationError);
+ await assert.rejects(()=>s.create('k',{items:[{sku:'a',quantity:1.5,unitPrice:1}]}),ValidationError);
+ await assert.rejects(()=>s.create('k',{items:[{sku:'a',quantity:1,unitPrice:-1}]}),ValidationError);
+ await assert.rejects(()=>s.create('k',{items:[{sku:'a',quantity:1,unitPrice:1.5}]}),ValidationError);
+ await assert.rejects(()=>s.create('k',{}),ValidationError);
+});
+
+test('totals persist for multi-item and zero-price orders',async()=>{
+ const repo=new Repository(); const s=new OrderService(repo);
+ const r=await s.create('k',{items:[{sku:'a',quantity:2,unitPrice:750},{sku:'b',quantity:3,unitPrice:0}]});
+ assert.equal(r.status,201); assert.equal(r.order.total,1500); assert.equal(repo.orders[0].total,1500);
+});
+
+test('different keys create separate orders, replay matches original',async()=>{
+ const repo=new Repository(); const s=new OrderService(repo);
+ const body={items:[{sku:'book',quantity:2,unitPrice:750}]};
+ const a=await s.create('one',body); const b=await s.create('two',body);
+ assert.equal(a.status,201); assert.equal(b.status,201); assert.notEqual(a.order.id,b.order.id); assert.equal(repo.orders.length,2);
+ const replay=await s.create('one',body);
+ assert.equal(replay.status,200); assert.deepEqual(replay.order,a.order); assert.equal(repo.orders.length,2);
+});
+
+test('replay ignores extra item fields via normalization but conflicts on changed values',async()=>{
+ const repo=new Repository(); const s=new OrderService(repo);
+ const clean={items:[{sku:'book',quantity:2,unitPrice:750}]};
+ const extra={items:[{sku:'book',quantity:2,unitPrice:750,note:'gift'}]};
+ const changed={items:[{sku:'book',quantity:2,unitPrice:800}]};
+ const a=await s.create('k',clean);
+ const same=await s.create('k',extra); assert.equal(same.status,200); assert.deepEqual(same.order,a.order);
+ const conflict=await s.create('k',changed); assert.equal(conflict.status,409); assert.deepEqual(conflict.order,a.order);
+ assert.equal(repo.orders.length,1);
+});
+
+test('concurrency across distinct keys yields distinct orders',async()=>{
+ const repo=new Repository(); const s=new OrderService(repo);
+ const body={items:[{sku:'book',quantity:2,unitPrice:750}]};
+ const results=await Promise.all(['x','y','z','z','x'].map(k=>s.create(k,body)));
+ assert.equal(repo.orders.length,3);
+ assert.equal(new Set(results.filter(r=>r.status===201).map(r=>r.order.id)).size,3);
+});
+
+test('HTTP creates, replays, conflicts, and rejects missing key',async()=>{
+ const server=app(); await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));
+ const port=(server.address() as any).port; const url=`http://127.0.0.1:${port}/orders`;
+ const send=(b:any,key?:string)=>fetch(url,{method:'POST',headers:key?{'idempotency-key':key}:{},body:JSON.stringify(b)});
+ try{
+  const body={items:[{sku:'book',quantity:2,unitPrice:750}]};
+  assert.equal((await send(body)).status,400);
+  const created=await send(body,'dup'); assert.equal(created.status,201);
+  const createdJson=await created.json();
+  const replay=await send(body,'dup'); assert.equal(replay.status,200); assert.deepEqual(await replay.json(),createdJson);
+  const conflict=await send({items:[{sku:'other',quantity:1,unitPrice:2}]},'dup'); assert.equal(conflict.status,409);
+ }finally{ server.closeAllConnections(); await new Promise<void>(r=>server.close(()=>r())); }
+});
