@@ -1,2 +1,18 @@
 export type Item = {sku:string; quantity:number; unitPrice:number};
-export function parseItems(value: unknown): Item[] { return value as Item[]; }
+
+export class ValidationError extends Error {}
+
+function toItems(value:unknown):Item[]{
+  if(!Array.isArray(value)||value.length===0) throw new ValidationError('items must be a nonempty array');
+  return value.map((raw)=>{
+    if(typeof raw!=='object'||raw===null) throw new ValidationError('item must be an object');
+    const {sku,quantity,unitPrice}=raw as Record<string,unknown>;
+    if(!Number.isInteger(quantity)||quantity<=0) throw new ValidationError('quantity must be a positive integer');
+    if(!Number.isInteger(unitPrice)||unitPrice<0) throw new ValidationError('unitPrice must be an integer >= 0');
+    return {sku:sku as string,quantity:quantity as number,unitPrice:unitPrice as number};
+  });
+}
+
+export function parseItems(value:unknown):Item[]{ return toItems(value); }
+
+export function normalizePayload(value:unknown):string{ return JSON.stringify(toItems(value)); }
