-import {Repository} from './repository.ts';
-import {parseItems} from './validation.ts';
+import {Repository, type Order} from './repository.ts';
+import {parseItems, normalizePayload} from './validation.ts';
+
+export type CreateResult = {status:number; order:Order};
+
 export class OrderService {
-  repo:Repository; constructor(repo:Repository) { this.repo=repo; }
-  async create(key:string, body:any) { const items=parseItems(body.items); return {status:201,order:await this.repo.insert(items,0)}; }
+  repo:Repository;
+  inflight=new Map<string,Promise<Order>>();
+  constructor(repo:Repository) { this.repo=repo; }
+  async create(key:string, body:unknown):Promise<CreateResult> {
+    const rawItems=(body!==null&&typeof body==='object')?(body as {items?:unknown}).items:undefined;
+    const payload=normalizePayload(rawItems);
+    const items=parseItems(rawItems);
+    const existing=this.repo.find(key);
+    if(existing) return existing.payload===payload ? {status:200,order:existing.order} : {status:409,order:existing.order};
+    const pending=this.inflight.get(key);
+    if(pending) return {status:200,order:await pending};
+    const running=(async()=>{
+      const total=items.reduce((sum,item)=>sum+item.quantity*item.unitPrice,0);
+      const order=await this.repo.insert(items,total);
+      this.repo.save(key,payload,order);
+      return order;
+    })();
+    this.inflight.set(key,running);
+    try { return {status:201,order:await running}; }
+    finally { this.inflight.delete(key); }
+  }
 }
