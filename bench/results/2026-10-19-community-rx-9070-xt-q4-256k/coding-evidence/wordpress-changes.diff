+	public function __construct(private $db) {}
+
+	public function create($label, $owner) {
+		$inserted = $this->db->insert(
+			$this->db->prefix.'devnotes',
+			['label'=>$label,'owner_id'=>$owner],
+			['%s','%d']
+		);
+		if ($inserted === false) {
+			return false;
+		}
+		return ['id'=>$this->db->insert_id,'label'=>$label,'owner_id'=>$owner];
+	}
+
+	public function list_for($owner) {
+		$query = $this->db->prepare(
+			"SELECT * FROM {$this->db->prefix}devnotes WHERE owner_id = %d",
+			$owner
+		);
+		return $this->db->get_results($query, ARRAY_A);
+	}
 }
--- baseline/rest.php
+++ agent/rest.php
@@ -1,7 +1,38 @@
 <?php
 class DevNotesRest {
- public function __construct(private $repo) {}
- public function register() { register_rest_route('devnotes/v1','/notes',['methods'=>'POST','callback'=>[$this,'create'],'permission_callback'=>'__return_true']); }
- public function create($request) { return $this->repo->create($request['label'],$request['owner_id']); }
- public function index($request) { return $this->repo->list_for(get_current_user_id()); }
+	public function __construct(private $repo) {}
+
+	public function register() {
+		$permission = static function() { return current_user_can('edit_posts'); };
+		register_rest_route('devnotes/v1', '/notes', [
+			'methods' => 'GET',
+			'callback' => [$this, 'index'],
+			'permission_callback' => $permission,
+		]);
+		register_rest_route('devnotes/v1', '/notes', [
+			'methods' => 'POST',
+			'callback' => [$this, 'create'],
+			'permission_callback' => $permission,
+		]);
+	}
+
+	public function create($request) {
+		$label = sanitize_text_field($request['label'] ?? '');
+		if ($label === '') {
+			return new WP_Error('devnotes_invalid_label', 'A non-empty label is required.', ['status'=>400]);
+		}
+		$note = $this->repo->create($label, get_current_user_id());
+		if ($note === false) {
+			return new WP_Error('devnotes_db_error', 'Could not save the note.', ['status'=>500]);
+		}
+		return new WP_REST_Response($note, 201);
+	}
+
+	public function index($request) {
+		$notes = array_map(
+			static fn($note) => apply_filters('devnotes_note', $note),
+			$this->repo->list_for(get_current_user_id())
+		);
+		return new WP_REST_Response($notes, 200);
+	}
 }
