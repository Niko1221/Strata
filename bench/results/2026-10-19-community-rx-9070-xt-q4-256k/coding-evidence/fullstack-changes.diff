-export function createApi(db){return {async order(user,input){if(!user)throw Error('unauthorized');if(db.stock<input.quantity)throw Error('out of stock');await Promise.resolve();db.stock-=input.quantity;return db.insert({tenant:input.tenant,quantity:input.quantity});},async list(user){return db.orders;}};}
+export function createApi(db) {
+  return {
+    async order(user, input) {
+      if (!user) throw Error('unauthorized');
+      const quantity = input?.quantity;
+      if (!Number.isInteger(quantity) || quantity <= 0) throw Error('invalid quantity');
+      // Check and reserve synchronously: no await between them, so concurrent
+      // callers cannot both pass the check and oversell the same stock.
+      if (db.stock < quantity) throw Error('out of stock');
+      db.stock -= quantity;
+      try {
+        return await db.insert({ tenant: user.tenant, quantity });
+      } catch (err) {
+        db.stock += quantity;
+        throw err;
+      }
+    },
+    async list(user) {
+      if (!user) throw Error('unauthorized');
+      return db.orders.filter(o => o.tenant === user.tenant);
+    },
+  };
+}
