-export function createClient(fetchOrders){const state={orders:[],loading:false,error:null};return {state,async refresh(){state.loading=true;try{state.orders=await fetchOrders();}catch(e){state.error=e.message;}state.loading=false;}};}
+export function createClient(fetchOrders) {
+  const state = { orders: [], loading: false, error: null };
+  let seq = 0;
+  return {
+    state,
+    async refresh() {
+      const current = ++seq;
+      state.loading = true;
+      try {
+        const orders = await fetchOrders();
+        // Only the latest refresh may write state; a stale response arriving
+        // after a newer one completed must not overwrite or clear its result.
+        if (current === seq) {
+          state.orders = orders;
+          state.error = null;
+        }
+      } catch (e) {
+        if (current === seq) state.error = e.message;
+      }
+      if (current === seq) state.loading = false;
+    },
+  };
+}
