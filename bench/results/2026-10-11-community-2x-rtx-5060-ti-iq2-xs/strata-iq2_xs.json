{
 "exe": "<strata checkout>/engine/strata",
 "args": [
  "--pack",
  "<data root>/packs/iq2_xs",
  "--native",
  "<data root>/models/IQ2_XS/Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00001-of-00002.gguf",
  "--ple-gguf",
  "<data root>/models/IQ2_XS/Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00002-of-00002.gguf",
  "--expert-profile",
  "<strata checkout>/data/expert-profile.bin",
  "--prefill",
  "auto:32768",
  "--spec",
  "4",
  "--spec-min-p",
  "0.55",
  "--mtp",
  "<data root>/mtp/rt",
  "--max-context",
  "262144",
  "--kv",
  "int8",
  "--kv-resident",
  "32768",
  "--vision",
  "--vram-reserve-mib",
  "700",
  "--control-vector-scaled",
  "<strata checkout>/data/experimental-speed-projection/Qwen3.8-Flash-Next-experimental-speed-projection.gguf:1",
  "--control-vector-layer-range",
  "4",
  "44",
  "--cvec-mode",
  "project",
  "--cvec-dir",
  "per-layer",
  "--pool-workers",
  "8",
  "--conversation-cache-mib",
  "4096",
  "--conversation-cache-slots",
  "8",
  "--conversation-cache-min-free-mib",
  "2560",
  "--pipeline-windows",
  "2",
  "--adapt-every",
  "1",
  "--adapt-swaps",
  "160",
  "--adapt-decay",
  "0.97"
 ],
 "cwd": "<strata checkout>",
 "api_monitor": true,
 "reasoning_budget_tokens": 2048,
 "reasoning_loop_recovery": "recover",
 "tokenizer": "<data root>/packs/iq2_xs/tokenizer",
 "model_name": "local-llm",
 "log": "<strata checkout>/strata-iq2_xs.log",
 "lib_dirs": [
  "/usr/local/cuda/bin",
  "/usr/local/cuda/lib64"
 ],
 "port": 8081,
 "gpu": [
  0,
  1
 ],
 "gpus_asked": true,
 "layer_split": "27",
 "vision": {
  "exe": "<strata checkout>/engine/strata-vision",
  "mmproj": "<data root>/models/mmproj-Qwen3.8-Flash-Next-BF16.gguf",
  "model": "<data root>/models/IQ2_XS/Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00001-of-00002.gguf",
  "gpu": true,
  "max_tokens": 1024
 },
 "host": "0.0.0.0",
 "origins": [
  "http://<lan address>:8081",
  "http://127.0.0.1:8081",
  "http://localhost:8081"
 ],
 "fit_max_tokens": true
}
