{
  "exe": "./build-p100/strata.exe",
  "cwd": ".",
  "args": [
    "--pack",
    "./packs/ud-q4_k_xl",
    "--native",
    "./models/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf",
    "--mmap-experts",
    "--resident-cpu-experts",
    "--expert-profile",
    "./data/expert-profile.bin",
    "--expert-cache",
    "auto",
    "--vram-reserve-mib",
    "2048",
    "--layer-split",
    "24",
    "--split-device",
    "1",
    "--no-prefill-borrow",
    "--adapt-every",
    "0",
    "--pcie-frac",
    "0",
    "--prefill",
    "256",
    "--short-read",
    "0",
    "--prompt-cache",
    "0",
    "--spec",
    "3",
    "--spec-min-p",
    "0.5",
    "--mtp",
    "./mtp/rt",
    "--ple-io",
    "ram",
    "--pool-workers",
    "15",
    "--max-context",
    "4096"
  ],
  "env": {
    "CUDA_DISABLE_PTX_JIT": "1",
    "STRATA_P100_RAM_SPLIT": "1",
    "STRATA_LOOKAHEAD": "0",
    "STRATA_TRACE": "1",
    "STRATA_P100_HYBRID": "1",
    "STRATA_DECODE_TIMING": "1"
  },
  "lib_dirs": [
    "<CUDA 12 toolkit>/bin"
  ],
  "tokenizer": "./packs/ud-q4_k_xl/tokenizer",
  "model_name": "qwen3.8-flash-next",
  "log": "./strata-p100-engine.log",
  "host": "127.0.0.1",
  "port": 8080
}
