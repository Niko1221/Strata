+    const char* v = std::getenv("STRATA_GFX12_SPLIT_DECODE");
+    if (v != nullptr && v[0] == '0') return no("STRATA_GFX12_SPLIT_DECODE=0");
+    if (v != nullptr && v[0] == '1') return true;   // asked for: any topology, as setting the switches by hand would be
+    if (gpu_archs.size() < 2) return no("the split runs on one GPU");
+    for (const auto& a : gpu_archs)
+        if (!strata::kernels::gfx_arch_is_gfx12(a.c_str())) return no("not every GPU of the split is gfx12 (one is " + a + ")");
+    if (may_collapse)
+        return no("--split-skip-if-fits may still run it on one GPU; STRATA_GFX12_SPLIT_DECODE=1 asks for it anyway");
+    if (!measured_os) return no("measured on Linux only; STRATA_GFX12_SPLIT_DECODE=1 asks for it");
+    return true;
