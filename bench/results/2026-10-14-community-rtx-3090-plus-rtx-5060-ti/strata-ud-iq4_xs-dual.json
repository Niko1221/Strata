{
 "exe": "./build/strata",
 "args": [
  "--pack",
  "../Strata-data/packs/ud-iq4_xs",
  "--native",
  "../models/gguf/UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf",
  "--expert-profile",
  "./data/expert-profile.bin",
  "--expert-cache",
  "auto",
  "--prefill",
  "32768",
  "--feed-max",
  "52",
  "--spec",
  "4",
  "--spec-min-p",
  "0.5",
  "--spec-lookup",
  "16",
  "--adapt-every",
  "1",
  "--adapt-swaps",
  "192",
  "--mtp",
  "../Strata-data/mtp/rt-es",
  "--max-context",
  "200192",
  "--kv",
  "int8",
  "--pcie-mode",
  "kernel",
  "--pcie-frac",
  "0.25",
  "--second-gpu",
  "0",
  "--main-gpu",
  "1",
  "--head-split",
  "0.45",
  "--pool-workers",
  "7",
  "--second-gpu-reserve-mib",
  "512",
  "--second-gpu-prefetch-mb",
  "6",
  "--kv-grow",
  "--vram-pin-gib",
  "8",
  "--second-gpu-pin-gib",
  "8",
  "--ple-io",
  "ram"
 ],
 "cwd": ".",
 "tokenizer": "../Strata-data/packs/ud-iq4_xs/tokenizer",
 "model_name": "ud-iq4_xs-dual",
 "env_to_user": true,
 "log": "<engine-log-path>",
 "lib_dirs": [],
 "env": {
  "STRATA_IQ256_GATHER": "1",
  "STRATA_POOL_FUSED": "1"
 },
 "allowed_hosts": [
  "<host>"
 ]
}