+                unsigned bits = score == 0.0f ? 0 : __float_as_uint(score);
+                bits = bits & 0x80000000u ? ~bits : bits | 0x80000000u;
+                key = ((unsigned long long) bits << 32) | (unsigned) (vocab - 1 - token);
