{
  "exe": "/absolute/path/to/build/strata",
  "args": [
    "--pack",
    "/absolute/path/to/pack",
    "--native",
    "/absolute/path/to/model.gguf",
    "--ple-gguf",
    "/absolute/path/to/model.gguf",
    "--ple-io",
    "mmap",
    "--expert-profile",
    "/absolute/path/to/expert-profile.bin",
    "--spec",
    "4",
    "--spec-min-p",
    "0.70",
    "--kv",
    "int8",
    "--mtp",
    "/absolute/path/to/mtp",
    "--max-context",
    "131072",
    "--kv-resident",
    "32768",
    "--pcie-frac",
    "0.35",
    "--adapt-every",
    "1",
    "--adapt-swaps",
    "80",
    "--adapt-decay",
    "0.97",
    "--conversation-cache-mib",
    "8192",
    "--conversation-cache-slots",
    "2",
    "--conversation-cache-min-tokens",
    "1024",
    "--vram-elastic",
    "--prefill",
    "4096",
    "--expert-cache",
    "2000",
    "--conversation-cache-park-gain",
    "1024"
  ],
  "cwd": "/absolute/path/to/model-data",
  "tokenizer": "/absolute/path/to/pack/tokenizer",
  "model_name": "local-model",
  "fit_max_tokens": true,
  "env": {
    "STRATA_KV_PREFETCH": "1",
    "STRATA_SCORES_TURING": "2",
    "STRATA_SM75_PERF": "1",
    "STRATA_PF_FUSED": "1",
    "STRATA_PF_FUSED_SM75": "1",
    "STRATA_ROUTE_PRIOR": "1.5",
    "STRATA_KVA": "0",
    "STRATA_PF_FUSED_IQ1_M": "0"
  },
  "plain_prompt": false
}
