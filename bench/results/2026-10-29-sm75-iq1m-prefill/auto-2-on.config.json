{
  "exe": "$LAB/private/custom/build/strata",
  "args": [
    "--pack",
    "packs/swift15-iq2xs-gsq",
    "--native",
    "$HOME/models/swift15-flashnext-iq2xs/Swift-Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00001-of-00002.gguf",
    "--ple-gguf",
    "$HOME/models/swift15-flashnext-iq2xs/Swift-Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00001-of-00002.gguf",
    "--ple-io",
    "mmap",
    "--expert-profile",
    "$LAB/private/auto-2-on.expert-profile.bin",
    "--spec",
    "4",
    "--spec-min-p",
    "0.70",
    "--kv",
    "int8",
    "--mtp",
    "mtp/rt",
    "--max-context",
    "131072",
    "--kv-resident",
    "32768",
    "--pcie-frac",
    "0.35",
    "--adapt-every",
    "1",
    "--adapt-swaps",
    "80",
    "--adapt-decay",
    "0.97",
    "--conversation-cache-mib",
    "8192",
    "--conversation-cache-slots",
    "2",
    "--conversation-cache-min-tokens",
    "1024",
    "--vram-elastic",
    "--prefill",
    "auto:8192",
    "--expert-cache",
    "2000",
    "--conversation-cache-park-gain",
    "1024"
  ],
  "cwd": "$HOME/Desktop/github/strata-port",
  "tokenizer": "$HOME/Desktop/github/strata-port/packs/swift15-iq2xs-gsq/tokenizer",
  "model_name": "local-model",
  "fit_max_tokens": true,
  "env": {
    "STRATA_KV_PREFETCH": "1",
    "STRATA_SCORES_TURING": "2",
    "STRATA_SM75_PERF": "1",
    "STRATA_PREFILL_ELASTIC_LOAN": "1",
    "STRATA_PREFILL_MTP_LOAN": "1",
    "STRATA_PREFILL_HEAD_LOAN": "1",
    "STRATA_PREFILL_RETAIN_STARTUP_CHUNK": "1",
    "STRATA_PREFILL_REPEAT_LOAN": "1",
    "STRATA_PREFILL_REPEAT_MIN_TOKENS": "8192",
    "STRATA_SESSION_ALL_CHECKPOINTS": "0",
    "STRATA_SESSION_RESTORE_HOT": "1",
    "STRATA_PF_FUSED": "1",
    "STRATA_PF_FUSED_SM75": "1",
    "STRATA_PF_FUSED_SM75_IQ": "1",
    "STRATA_ROUTE_PRIOR": "1.5",
    "STRATA_KVA": "0",
    "STRATA_PF_FUSED_IQ1_M": "1",
    "STRATA_PREFILL_LEND_PCT": "100"
  },
  "plain_prompt": false
}
