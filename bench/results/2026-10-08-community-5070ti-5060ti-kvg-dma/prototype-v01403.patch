diff --git a/include/strata/core/dma_staging.hpp b/include/strata/core/dma_staging.hpp
new file mode 100644
index 0000000..18b0869
--- /dev/null
+++ b/include/strata/core/dma_staging.hpp
@@ -0,0 +1,102 @@
+#pragma once
+#include "strata/core/dma_batch.hpp"
+#include <algorithm>
+#include <cstring>
+
+namespace strata::core {
+
+/// Optional pageable-to-pinned staging for one device's adaptive stream. The owner decides the fixed upper
+/// bound from its swap count and largest expert blob. Direct pinned copies and disabled DMA keep the old path.
+/// A completion event protects CPU writes on reuse, independently of the residency controller's pending event.
+class AdaptiveDmaStaging {
+public:
+    explicit AdaptiveDmaStaging(size_t bound) : bound_(std::min<size_t>(bound, 256ull << 20)) {}
+    AdaptiveDmaStaging(const AdaptiveDmaStaging&) = delete;
+    AdaptiveDmaStaging& operator=(const AdaptiveDmaStaging&) = delete;
+    ~AdaptiveDmaStaging() {
+        if (!host_) return;
+        int previous = -1;
+        (void) cudaGetDevice(&previous);
+        (void) cudaSetDevice(device_);
+        (void) cudaDeviceSynchronize();
+        forget_host_aliases(host_, capacity_);
+        (void) cudaFreeHost(host_);
+        if (ready_) (void) cudaEventDestroy(ready_);
+        dma_batch_stats(device_).staging_capacity.fetch_sub(capacity_, std::memory_order_relaxed);
+        if (previous >= 0 && previous != device_) (void) cudaSetDevice(previous);
+    }
+
+    cudaError_t copy(void* const* dst, const void* const* src, const size_t* bytes, size_t n,
+                     cudaStream_t stream, int mode, bool enabled) {
+#if !defined(STRATA_USE_HIP) && !defined(STRATA_HIP_GFX906) && defined(CUDART_VERSION) && CUDART_VERSION >= 13000
+        if (enabled && mode != 0 && n > 1 && n <= 128) {
+            bool registered = true;
+            for (size_t i = 0; i < n; ++i) {
+                const void* alias = nullptr;
+                if (detail::host_alias(src[i], &alias) != cudaSuccess) { registered = false; break; }
+            }
+            (void) cudaGetLastError();
+            if (!registered) {
+                size_t total = 0;
+                for (size_t i = 0; i < n; ++i) {
+                    if (bytes[i] > bound_ - total) return copy_blobs(dst, src, bytes, n, stream, mode);
+                    total += bytes[i];
+                }
+                if (total == 0) return copy_blobs(dst, src, bytes, n, stream, mode);
+                int device = -1;
+                cudaError_t e = cudaGetDevice(&device);
+                if (e != cudaSuccess) return e;
+                if (host_ && device != device_) return cudaErrorInvalidDevice;
+                if (live_) {
+                    e = cudaEventSynchronize(ready_);
+                    if (e != cudaSuccess) return e;
+                    live_ = false;
+                }
+                if (!host_) {
+                    cudaEvent_t ready = nullptr;
+                    e = cudaEventCreateWithFlags(&ready, cudaEventDisableTiming);
+                    if (e != cudaSuccess) return e;
+                    // Keep one stable allocation. Round only to 64 KiB, not a fixed 256 MiB per GPU.
+                    const size_t capacity = (bound_ + 65535) / 65536 * 65536;
+                    uint8_t* host = nullptr;
+                    e = cudaHostAlloc((void**) &host, capacity, cudaHostAllocPortable | cudaHostAllocMapped);
+                    if (e != cudaSuccess) {
+                        (void) cudaEventDestroy(ready);
+                        (void) cudaGetLastError();
+                        return copy_blobs(dst, src, bytes, n, stream, mode);
+                    }
+                    host_ = host; capacity_ = capacity; device_ = device; ready_ = ready;
+                    dma_batch_stats(device).staging_capacity.fetch_add(capacity, std::memory_order_relaxed);
+                    std::fprintf(stderr, "strata adaptive DMA bounce CUDA%d: %.1f MiB portable pinned staging\n",
+                                 device, (double) capacity / 1048576.0);
+                }
+                const void* staged[128] = {};
+                size_t offset = 0;
+                for (size_t i = 0; i < n; ++i) {
+                    std::memcpy(host_ + offset, src[i], bytes[i]);
+                    staged[i] = host_ + offset;
+                    offset += bytes[i];
+                }
+                e = copy_blobs(dst, staged, bytes, n, stream, mode);
+                if (e != cudaSuccess) return e;
+                dma_batch_stats(device).staged_batches.fetch_add(1, std::memory_order_relaxed);
+                dma_batch_stats(device).staged_bytes.fetch_add(total, std::memory_order_relaxed);
+                e = cudaEventRecord(ready_, stream);
+                if (e == cudaSuccess) live_ = true;
+                return e;
+            }
+        }
+#else
+        (void) enabled;
+#endif
+        return copy_blobs(dst, src, bytes, n, stream, mode);
+    }
+    size_t capacity() const { return capacity_; }
+private:
+    size_t bound_ = 0, capacity_ = 0;
+    uint8_t* host_ = nullptr;
+    int device_ = -1;
+    cudaEvent_t ready_ = nullptr;
+    bool live_ = false;
+};
+}  // namespace strata::core
