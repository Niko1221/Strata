+        CHECK(cudaMemcpy(data.data(), kv[device].base(), data.size(), cudaMemcpyDeviceToHost) == cudaSuccess);
+        for (uint8_t b : data) CHECK(b == 0x70 + device);
+        VmmChunk returned = kv[device].unmap(1);
+        CHECK(returned != 0 && vmm_chunk_device(returned) == device);
+        CHECK(cache[device].map_range(3, 4, [&] { VmmChunk h = returned; returned = 0; return h; }));
+        CHECK(cudaMemcpy(data.data(), cache[device].base() + 3 * gran[device], data.size(), cudaMemcpyDeviceToHost) == cudaSuccess);
+        for (uint8_t b : data) CHECK(b == 0x40 + device);
+        CHECK(cache[device].base() == cache_address[device] && kv[device].base() == kv_address[device]);
+    }
+    // A chunk from GPU0 must never become GPU1's KV, even on a machine with peer access.
+    CHECK(cudaSetDevice(0) == cudaSuccess);
+    VmmChunk wrong = vmm_chunk_new();
+    CHECK(wrong != 0 && vmm_chunk_device(wrong) == 0);
+    CHECK(cudaSetDevice(1) == cudaSuccess);
+    CHECK(!kv[1].map_range(2, 3, [&] { VmmChunk h = wrong; wrong = 0; return h; }));
+    CHECK(!kv[1].mapped(2) && kv[1].mapped_count() == 1);
+    // Destruction/release still uses the range's owner after another device became current.
+    cache[0].release(); kv[0].release();
+    CHECK(cache[0].base() == nullptr && kv[0].base() == nullptr);
+    CHECK(cudaGetLastError() == cudaSuccess);
+    std::printf("dual_vmm_test: GPU ownership, cache/KV exchange, data retention, stable addresses and foreign-chunk rejection passed\n");
+    return failures ? 1 : 0;
+}
