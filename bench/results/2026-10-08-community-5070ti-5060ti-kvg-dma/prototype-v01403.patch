diff --git a/tests/core/dma_alias_lifetime_test.cpp b/tests/core/dma_alias_lifetime_test.cpp
new file mode 100644
index 0000000..c8cfc49
--- /dev/null
+++ b/tests/core/dma_alias_lifetime_test.cpp
@@ -0,0 +1,34 @@
+#include "strata/core/dma_batch.hpp"
+#include <cstdio>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+
+int main() {
+    int count = 0;
+    CHECK(cudaGetDeviceCount(&count) == cudaSuccess && count >= 2);
+    unsigned char* host = nullptr;
+    CHECK(cudaHostAlloc((void**) &host, 65536, cudaHostAllocPortable | cudaHostAllocMapped) == cudaSuccess);
+    const void* interior = host + 4096;
+    for (int device = 0; device < 2; ++device) {
+        CHECK(cudaSetDevice(device) == cudaSuccess);
+        const void* alias = nullptr;
+        CHECK(strata::core::detail::host_alias(interior, &alias) == cudaSuccess);
+    }
+#ifndef STRATA_DMA_LEGACY_REPRO
+    strata::core::forget_host_aliases(host, 65536);
+#endif
+    CHECK(cudaFreeHost(host) == cudaSuccess);
+    // Query only: never read or copy freed memory. A lifetime-aware cache must re-query CUDA and reject it.
+    for (int device = 0; device < 2; ++device) {
+        CHECK(cudaSetDevice(device) == cudaSuccess);
+        const void* alias = nullptr;
+        const auto e = strata::core::detail::host_alias(interior, &alias);
+        if (e == cudaSuccess) {
+            std::fprintf(stderr, "BUG reproduced: CUDA%d returned a cached alias for freed pinned storage\n", device);
+            return 1;
+        }
+        (void) cudaGetLastError();
+    }
+    std::puts("dma_alias_lifetime_test: freed interior addresses rejected on both devices");
+    return 0;
+}
diff --git a/tests/core/dual_dma_test.cpp b/tests/core/dual_dma_test.cpp
new file mode 100644
index 0000000..a909c29
--- /dev/null
+++ b/tests/core/dual_dma_test.cpp
@@ -0,0 +1,85 @@
+#include "strata/core/dma_batch.hpp"
+#include "strata/core/dma_staging.hpp"
+#include <cuda_runtime.h>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <chrono>
+#include <thread>
+
+static void CUDART_CB delay(void*) { std::this_thread::sleep_for(std::chrono::milliseconds(100)); }
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+
+int main() {
+    int count = 0;
+    CHECK(cudaGetDeviceCount(&count) == cudaSuccess && count >= 2);
+    constexpr size_t n = 4, bytes = 4096;
+    unsigned char* host = nullptr;
+    CHECK(cudaHostAlloc((void**) &host, n * bytes, cudaHostAllocPortable | cudaHostAllocMapped) == cudaSuccess);
+    for (size_t i = 0; i < n; ++i) std::memset(host + i * bytes, int(0x30 + i), bytes);
+    for (int device = 0; device < 2; ++device) {
+        CHECK(cudaSetDevice(device) == cudaSuccess);
+        unsigned char* target = nullptr;
+        cudaStream_t stream = nullptr;
+        CHECK(cudaMalloc((void**) &target, n * bytes) == cudaSuccess);
+        CHECK(cudaStreamCreate(&stream) == cudaSuccess);
+        void* dst[n]; const void* src[n]; size_t sizes[n];
+        for (size_t i = 0; i < n; ++i) { dst[i] = target + i * bytes; src[i] = host + i * bytes; sizes[i] = bytes; }
+        for (int mode : {1, 2}) {
+            CHECK(cudaMemsetAsync(target, 0, n * bytes, stream) == cudaSuccess);
+            const auto before = strata::core::dma_batch_stats(device).batches.load();
+            CHECK(strata::core::copy_blobs(dst, src, sizes, n, stream, mode) == cudaSuccess);
+            CHECK(cudaStreamSynchronize(stream) == cudaSuccess);
+            CHECK(strata::core::dma_batch_stats(device).batches.load() == before + 1);
+            std::vector<unsigned char> actual(n * bytes);
+            CHECK(cudaMemcpy(actual.data(), target, actual.size(), cudaMemcpyDeviceToHost) == cudaSuccess);
+            CHECK(std::memcmp(actual.data(), host, actual.size()) == 0);
+        }
+        // Unregistered sources must still copy correctly through the loop fallback.
+        std::array<unsigned char, n * bytes> pageable{};
+        for (size_t i = 0; i < n; ++i) { std::memset(pageable.data() + i * bytes, int(0x50 + device + i), bytes); src[i] = pageable.data() + i * bytes; }
+        const auto fallback = strata::core::dma_batch_stats(device).fallbacks.load();
+        CHECK(strata::core::copy_blobs(dst, src, sizes, n, stream, 1) == cudaSuccess);
+        CHECK(cudaStreamSynchronize(stream) == cudaSuccess);
+        CHECK(strata::core::dma_batch_stats(device).fallbacks.load() == fallback + 1);
+        std::array<unsigned char, n * bytes> actual{};
+        CHECK(cudaMemcpy(actual.data(), target, actual.size(), cudaMemcpyDeviceToHost) == cudaSuccess);
+        CHECK(actual == pageable);
+        // Force the first upload to remain queued while its CPU staging is reused for a second pattern.
+        // Both destinations must retain their own bytes; the source arrays themselves are pageable.
+        {
+            strata::core::AdaptiveDmaStaging stage(n * bytes);
+            unsigned char* second = nullptr;
+            CHECK(cudaMalloc((void**) &second, n * bytes) == cudaSuccess);
+            // Allocate and register the staging storage before inserting the delay: cudaHostAlloc may itself
+            // synchronize the device, which would otherwise consume the delay and weaken this regression.
+            CHECK(stage.copy(dst, src, sizes, n, stream, 1, true) == cudaSuccess);
+            CHECK(cudaStreamSynchronize(stream) == cudaSuccess);
+            CHECK(cudaLaunchHostFunc(stream, delay, nullptr) == cudaSuccess);
+            CHECK(stage.copy(dst, src, sizes, n, stream, 1, true) == cudaSuccess);
+            const auto first_pattern = pageable;
+            for (size_t i = 0; i < n; ++i) {
+                std::memset(pageable.data() + i * bytes, int(0x70 + device + i), bytes);
+                dst[i] = second + i * bytes;
+            }
+            CHECK(stage.copy(dst, src, sizes, n, stream, 1, true) == cudaSuccess);
+            CHECK(cudaStreamSynchronize(stream) == cudaSuccess);
+            CHECK(cudaMemcpy(actual.data(), target, actual.size(), cudaMemcpyDeviceToHost) == cudaSuccess);
+            CHECK(actual == first_pattern);
+            CHECK(cudaMemcpy(actual.data(), second, actual.size(), cudaMemcpyDeviceToHost) == cudaSuccess);
+            CHECK(actual == pageable);
+            CHECK(stage.capacity() == 65536);  // bounded staging replaces 256 MiB, without altering the output
+            CHECK(cudaFree(second) == cudaSuccess);
+        }
+        CHECK(strata::core::dma_batch_stats(device).staging_capacity.load() == 0);
+        CHECK(cudaStreamDestroy(stream) == cudaSuccess);
+        CHECK(cudaFree(target) == cudaSuccess);
+    }
+    strata::core::forget_host_aliases(host, n * bytes);
+    CHECK(cudaFreeHost(host) == cudaSuccess);
+    std::printf("dual_dma_test: both GPUs mode1/mode2 batch, pageable fallback and delayed staging reuse passed; overlap_hint_compiled=%d\n",
+                strata::core::dma_overlap_hint_compiled() ? 1 : 0);
+    return 0;
+}
