new file mode 100644
index 0000000..45ba645
--- /dev/null
+++ b/tools/test_done_dual_metadata.py
@@ -0,0 +1,20 @@
+"""Regression for unchanged legacy DONE fields and per-device extension fields."""
+import pathlib
+import sys
+
+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
+from serve.server import StrataEngine
+
+engine = StrataEngine.__new__(StrataEngine)
+engine.info = {}
+engine._parse_done('DONE 8 32768 15000 70 stop 6 7 0 90 100 1 2 3.5 32768 4')
+legacy = dict(engine.last)
+assert legacy['generated'] == 8 and legacy['prompt_tokens'] == 32768
+assert legacy['offloaded'] == 4 and legacy['reused'] == 0 and legacy['file_mb'] == 3.5
+engine._parse_done('DONE 8 32768 15000 70 stop 6 7 0 90 100 1 2 3.5 32768 4 '
+                   'kv_gpu0_mib=320.5 kv_gpu1_mib=160 kv_grow_active=1 '
+                   'dma_gpu0_batches=12 dma_gpu1_batches=7 dev_build=pp32-dual-v1')
+assert all(engine.last[key] == value for key, value in legacy.items())
+assert engine.last['kv_gpu0_mib'] == 320.5 and engine.last['kv_gpu1_mib'] == 160
+assert engine.info['dma_gpu1_batches'] == 7 and engine.info['dev_build'] == 'pp32-dual-v1'
+print('DONE legacy and independent GPU metadata regression passed')
