diff --git a/tests/core/dual_dma_test.cpp b/tests/core/dual_dma_test.cpp
new file mode 100644
index 0000000..ad4ffb3
--- /dev/null
+++ b/tests/core/dual_dma_test.cpp
@@ -0,0 +1,52 @@
+#include "strata/core/dma_batch.hpp"
+#include <cuda_runtime.h>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+
+int main() {
+    int count = 0;
+    CHECK(cudaGetDeviceCount(&count) == cudaSuccess && count >= 2);
+    constexpr size_t n = 4, bytes = 4096;
+    unsigned char* host = nullptr;
+    CHECK(cudaHostAlloc((void**) &host, n * bytes, cudaHostAllocPortable | cudaHostAllocMapped) == cudaSuccess);
+    for (size_t i = 0; i < n; ++i) std::memset(host + i * bytes, int(0x30 + i), bytes);
+    for (int device = 0; device < 2; ++device) {
+        CHECK(cudaSetDevice(device) == cudaSuccess);
+        unsigned char* target = nullptr;
+        cudaStream_t stream = nullptr;
+        CHECK(cudaMalloc((void**) &target, n * bytes) == cudaSuccess);
+        CHECK(cudaStreamCreate(&stream) == cudaSuccess);
+        void* dst[n]; const void* src[n]; size_t sizes[n];
+        for (size_t i = 0; i < n; ++i) { dst[i] = target + i * bytes; src[i] = host + i * bytes; sizes[i] = bytes; }
+        for (int mode : {1, 2}) {
+            CHECK(cudaMemsetAsync(target, 0, n * bytes, stream) == cudaSuccess);
+            const auto before = strata::core::dma_batch_stats(device).batches.load();
+            CHECK(strata::core::copy_blobs(dst, src, sizes, n, stream, mode) == cudaSuccess);
+            CHECK(cudaStreamSynchronize(stream) == cudaSuccess);
+            CHECK(strata::core::dma_batch_stats(device).batches.load() == before + 1);
+            std::vector<unsigned char> actual(n * bytes);
+            CHECK(cudaMemcpy(actual.data(), target, actual.size(), cudaMemcpyDeviceToHost) == cudaSuccess);
+            CHECK(std::memcmp(actual.data(), host, actual.size()) == 0);
+        }
+        // Unregistered sources must still copy correctly through the loop fallback.
+        std::array<unsigned char, n * bytes> pageable{};
+        for (size_t i = 0; i < n; ++i) { std::memset(pageable.data() + i * bytes, int(0x50 + device + i), bytes); src[i] = pageable.data() + i * bytes; }
+        const auto fallback = strata::core::dma_batch_stats(device).fallbacks.load();
+        CHECK(strata::core::copy_blobs(dst, src, sizes, n, stream, 1) == cudaSuccess);
+        CHECK(cudaStreamSynchronize(stream) == cudaSuccess);
+        CHECK(strata::core::dma_batch_stats(device).fallbacks.load() == fallback + 1);
+        std::array<unsigned char, n * bytes> actual{};
+        CHECK(cudaMemcpy(actual.data(), target, actual.size(), cudaMemcpyDeviceToHost) == cudaSuccess);
+        CHECK(actual == pageable);
+        CHECK(cudaStreamDestroy(stream) == cudaSuccess);
+        CHECK(cudaFree(target) == cudaSuccess);
+    }
+    CHECK(cudaFreeHost(host) == cudaSuccess);
+    std::printf("dual_dma_test: both GPUs mode1/mode2 pinned batch data and pageable fallback passed; overlap_hint_compiled=%d\n",
+                strata::core::dma_overlap_hint_compiled() ? 1 : 0);
+    return 0;
+}
diff --git a/tests/core/dual_vmm_test.cpp b/tests/core/dual_vmm_test.cpp
new file mode 100644
index 0000000..9d67cca
--- /dev/null
+++ b/tests/core/dual_vmm_test.cpp
@@ -0,0 +1,63 @@
+#include "strata/core/vmm.hpp"
+#include <cuda_runtime.h>
+#include <array>
+#include <cstdio>
+
+using namespace strata::core;
+static int failures = 0;
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); ++failures; return 1; } } while (0)
+
+int main() {
+    int count = 0;
+    CHECK(cudaGetDeviceCount(&count) == cudaSuccess && count >= 2);
+    std::array<VmmRange, 2> cache, kv;
+    std::array<uint8_t*, 2> cache_address{}, kv_address{};
+    std::array<uint64_t, 2> gran{};
+    for (int device = 0; device < 2; ++device) {
+        CHECK(cudaSetDevice(device) == cudaSuccess);
+        CHECK(vmm_available());
+        gran[device] = vmm_granularity();
+        CHECK(gran[device] > 0);
+        CHECK(cache[device].reserve(4 * gran[device]));
+        CHECK(kv[device].reserve(4 * gran[device]));
+        CHECK(cache[device].device() == device && kv[device].device() == device);
+        cache_address[device] = cache[device].base();
+        kv_address[device] = kv[device].base();
+        CHECK(cache[device].map_range(0, 4, [] { return VmmChunk{0}; }));
+        CHECK(cudaMemset(cache[device].base(), 0x20 + device, gran[device]) == cudaSuccess);
+        VmmChunk donated = cache[device].unmap(3);
+        CHECK(donated != 0 && vmm_chunk_device(donated) == device);
+        CHECK(kv[device].map_range(0, 1, [&] { VmmChunk h = donated; donated = 0; return h; }));
+        CHECK(cudaMemset(kv[device].base(), 0x70 + device, gran[device]) == cudaSuccess);
+        CHECK(kv[device].map_range(1, 2, [] { return VmmChunk{0}; }));
+        CHECK(cudaMemset(kv[device].base() + gran[device], 0x40 + device, gran[device]) == cudaSuccess);
+        CHECK(cudaDeviceSynchronize() == cudaSuccess);
+    }
+    for (int device = 0; device < 2; ++device) {
+        CHECK(cudaSetDevice(device) == cudaSuccess);
+        std::array<uint8_t, 64> data{};
+        CHECK(cudaMemcpy(data.data(), cache[device].base(), data.size(), cudaMemcpyDeviceToHost) == cudaSuccess);
+        for (uint8_t b : data) CHECK(b == 0x20 + device);
+        CHECK(cudaMemcpy(data.data(), kv[device].base(), data.size(), cudaMemcpyDeviceToHost) == cudaSuccess);
+        for (uint8_t b : data) CHECK(b == 0x70 + device);
+        VmmChunk returned = kv[device].unmap(1);
+        CHECK(returned != 0 && vmm_chunk_device(returned) == device);
+        CHECK(cache[device].map_range(3, 4, [&] { VmmChunk h = returned; returned = 0; return h; }));
+        CHECK(cudaMemcpy(data.data(), cache[device].base() + 3 * gran[device], data.size(), cudaMemcpyDeviceToHost) == cudaSuccess);
+        for (uint8_t b : data) CHECK(b == 0x40 + device);
+        CHECK(cache[device].base() == cache_address[device] && kv[device].base() == kv_address[device]);
+    }
+    // A chunk from GPU0 must never become GPU1's KV, even on a machine with peer access.
+    CHECK(cudaSetDevice(0) == cudaSuccess);
+    VmmChunk wrong = vmm_chunk_new();
+    CHECK(wrong != 0 && vmm_chunk_device(wrong) == 0);
+    CHECK(cudaSetDevice(1) == cudaSuccess);
+    CHECK(!kv[1].map_range(2, 3, [&] { VmmChunk h = wrong; wrong = 0; return h; }));
+    CHECK(!kv[1].mapped(2) && kv[1].mapped_count() == 1);
+    // Destruction/release still uses the range's owner after another device became current.
+    cache[0].release(); kv[0].release();
+    CHECK(cache[0].base() == nullptr && kv[0].base() == nullptr);
+    CHECK(cudaGetLastError() == cudaSuccess);
+    std::printf("dual_vmm_test: GPU ownership, cache/KV exchange, data retention, stable addresses and foreign-chunk rejection passed\n");
+    return failures ? 1 : 0;
+}
