{
  "exe": "${WORKSPACE}\\engines\\strata\\app\\engine\\rocm\\bin\\strata.exe",
  "cwd": "${WORKSPACE}\\engines\\strata\\app",
  "backend": "hip",
  "gpu": 0,
  "lib_dirs": [
    "${WORKSPACE}\\engines\\strata\\app\\engine\\rocm\\bin"
  ],
  "tokenizer": "${WORKSPACE}\\models\\strata\\huihui-ud-iq4-xs\\tokenizer",
  "model_name": "huihui-qwen3.8-flash-next-iq4-xs",
  "host": "127.0.0.1",
  "port": 8080,
  "log": "${WORKSPACE}\\engines\\strata\\logs\\engine.log",
  "open_browser": false,
  "parallel": 1,
  "reasoning_effort": "high",
  "engine_silence_s": 300,
  "env": {
    "STRATA_HIPBLASLT_TUNING": "${WORKSPACE}\\engines\\strata\\app\\tools\\hip\\gfx1151-hipblaslt-100500.txt",
    "STRATA_PF_FUSED": "1",
    "STRATA_PF_GEMM": "1",
    "STRATA_HC_UPMIX": "1",
    "STRATA_PA_FAST": "1",
    "STRATA_HIP_WMMA": "1",
    "STRATA_SELECT_WMMA": "1",
    "STRATA_HC_Q8": "1",
    "STRATA_PF_SWITCH_MIN_T": "4096",
    "STRATA_PREFILL_STREAM_MIN": "128",
    "HIPBLASLT_TENSILE_LIBPATH": "${WORKSPACE}\\engines\\strata\\app\\engine\\rocm\\bin\\hipblaslt\\library\\gfx1151",
    "STRATA_FILE_RELEASE": "1",
    "STRATA_UNBUFFERED_LOAD": "1"
  },
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0.0,
    "seed": 12345
  },
  "args": [
    "--pack",
    "${WORKSPACE}\\models\\strata\\huihui-ud-iq4-xs",
    "--native",
    "${WORKSPACE}\\models\\unsloth-UD-IQ4_XS\\Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf",
    "--expert-profile",
    "${WORKSPACE}\\engines\\strata\\app\\data\\expert-profile.bin",
    "--mmap-experts",
    "--expert-cache",
    "24576",
    "--prefill",
    "16384",
    "--spec",
    "6",
    "--max-context",
    "262144",
    "--kv",
    "int8",
    "--pool-workers",
    "8",
    "--pcie-frac",
    "0",
    "--adapt-every",
    "0",
    "--vram-reserve-mib",
    "4096",
    "--prompt-cache",
    "6",
    "--conversation-cache-mib",
    "0",
    "--mtp",
    "${WORKSPACE}\\models\\strata\\mtp-rt",
    "--mtp-window",
    "8192",
    "--no-prefill-borrow",
    "--resident-budget-gib",
    "1",
    "--spec-min-p",
    "0.4",
    "--vision"
  ],
  "reasoning_budget_tokens": 8192,
  "vision": {
    "exe": "${WORKSPACE}\\engines\\strata\\vision\\bin\\strata-vision.exe",
    "mmproj": "${WORKSPACE}\\models\\vision\\mmproj-Qwen3.8-Flash-Next-BF16.gguf",
    "model": "${WORKSPACE}\\models\\unsloth-UD-IQ4_XS\\Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf",
    "gpu": true,
    "threads": 16,
    "min_tokens": 1024,
    "max_tokens": 8192
  }
}
