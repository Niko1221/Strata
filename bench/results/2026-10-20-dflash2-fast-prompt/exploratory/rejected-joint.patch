+// The optional joint gate bounds the product of selector confidences over the
+// whole proposed prefix. These scores are a scheduling heuristic, not calibrated
+// acceptance probabilities; the target still verifies every retained proposal.
+inline int dflash_confidence_prefix(const float* p, int n, float floor, bool joint) {
+    float confidence = 1;
+    int prefix = 0;
+    while (prefix < n) {
+        const float value = p[prefix];
+        if (joint) {
+            if (!std::isfinite(value) || value < 0 || value > 1) break;
+            confidence *= value;
+        } else confidence = value;
+        if (!(confidence >= floor)) break;
+        ++prefix;
+    }
+    return prefix;
+}
