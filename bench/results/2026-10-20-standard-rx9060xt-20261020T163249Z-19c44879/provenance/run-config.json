{
  "exe": "/opt/strata/build-hip/strata",
  "cwd": "/opt/strata",
  "backend": "hip",
  "hip_ordinal": 0,
  "model_name": "qwen3.8-flash-next-iq2_xs",
  "aliases": [
    "qwen3.8-flash-next",
    "strata"
