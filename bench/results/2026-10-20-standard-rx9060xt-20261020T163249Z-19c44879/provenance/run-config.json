  "vision": {
    "exe": "/opt/strata/build-hip/strata-vision",
    "mmproj": "/data/models/vision/mmproj-Qwen3.8-Flash-Next-BF16.gguf",
    "model": "/data/models/IQ2_XS/Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00001-of-00002.gguf",
