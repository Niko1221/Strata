    "/data/models/IQ2_XS/Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00002-of-00002.gguf",
    "--expert-profile",
    "/opt/strata/data/expert-profile.bin",
    "--expert-cache",
    "auto",
    "--prefill",
    "8192",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--mtp",
    "/data/mtp/rt",
    "--max-context",
    "524288",
    "--kv",
    "q4_0",
    "--kv-resident",
    "32768",
    "--resident-experts",
