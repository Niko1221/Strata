  "env": {
    "STRATA_HIPBLASLT_TUNING": "tools/hip/gfx1200-hipblaslt-100202-t8k.txt (mounted as /config/...)",
    "STRATA_HC_Q8": "1",
    "STRATA_RESIDENT_HEADROOM_GIB": "5",
