+// Four query heads share one KV head. Stage each key/value tile once for
+// those heads; each head keeps the original QK and ordered PV arithmetic.
+template<int PageShift>
+__global__ void attention128_shared_gqa(const float* q, const uint16_t* k, const uint16_t* v,
+                                        const int32_t* table, const int32_t* steps, float* scratch,
+                                        int rows, int chunks, int window) {
+    constexpr int Heads=32,KV=8,HD=128;
+    const int chunk=blockIdx.x,kv_head=blockIdx.y,row=blockIdx.z;
+    const int t=threadIdx.x,local=t%HD,group=t/HD,head=kv_head*4+group;
+    const int lane=local&31,warp=local/32;
+    const int end=steps[row*4+1],position=end-rows+row;
+    const int first=window?max(0,end-rows-window+1):0;
+    const int begin=first+chunk*64;
+    __shared__ uint16_t keys[64*HD],values[64*HD];
+    __shared__ float scores[4][64],probabilities[4][64];
+    for(int i=t;i<64*HD;i+=4*HD) {
+        const int cell=begin+i/HD,d=i%HD;
+        const bool visible=cell<end&&(!window||abs(cell-position)<window);
+        uint16_t key=0,value=0;
+        if(visible) {
+            const size_t poolrow=((size_t)table[cell>>PageShift]*KV+kv_head)*(1<<PageShift)+
+                                  (cell&((1<<PageShift)-1));
+            key=k[poolrow*HD+d];value=v[poolrow*HD+d];
+        }
+        keys[i]=key;values[i]=value;
+    }
+    __syncthreads();
+    for(int c=warp;c<64;c+=4) {
+        const int cell=begin+c;
+        const bool visible=cell<end&&(!window||abs(cell-position)<window);
+        float dot=0;
+        if(visible) {
+            for(int d=lane;d<HD;d+=32)
+                dot+=q[(row*Heads+head)*HD+d]*__half2float(__ushort_as_half(keys[c*HD+d]));
+            for(int offset=16;offset;offset>>=1)dot+=__shfl_xor_sync(0xffffffffu,dot,offset);
+        }
+        if(!lane)scores[group][c]=visible?dot*0.08838834764831845f:-INFINITY;
+    }
+    __syncthreads();
+    float maximum=-INFINITY;
+    for(int c=0;c<64;++c)maximum=fmaxf(maximum,scores[group][c]);
+    if(local<64&&scores[group][local]!=-INFINITY)
+        probabilities[group][local]=expf(scores[group][local]-maximum);
+    __syncthreads();
+    float sum=0,acc=0;
+    for(int c=0;c<64;++c) {
+        if(scores[group][c]==-INFINITY)continue;
+        const float probability=probabilities[group][c];
+        sum+=probability;
+        acc+=probability*__half2float(__ushort_as_half(values[c*HD+local]));
+    }
+    float* destination=scratch+((row*Heads+head)*chunks+chunk)*130;
+    destination[local]=acc;
+    if(!local){destination[128]=maximum;destination[129]=sum;}
+}
