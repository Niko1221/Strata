array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F<] | [\\] ( ["\\bfnrt] | "u" ( [0-9a-cA-Ce-fE-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]         | [dD] [0-7c-fC-F] [0-9a-fA-F] [0-9a-fA-F] ) )
decimal-part ::= [0-9]{1,16}
description ::= description-0 | null
description-0 ::= "\"" description-0-guard-state-0 "\""
description-0-guard-state-0 ::= [^"\\\x7F\x00-\x1F<] description-0-guard-state-0 | [\\] ( ["\\bfnrt] | "u" ( [0-9a-cA-Ce-fE-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]         | [dD] [0-7c-fC-F] [0-9a-fA-F] [0-9a-fA-F] ) ) description-0-guard-state-0 | ""
description-kv ::= "\"description\"" space ":" space description
description-rest ::= ( "," space line-kv )? line-rest
file-path ::= "\"" ([0-9A-Za-z_./:-]+) "\""
file-path-kv ::= "\"file_path\"" space ":" space file-path
integral-part ::= [0] | [1-9] [0-9]{0,15}
line ::= line-0 | null
line-0 ::= ([1-9] [0-9]{0,15})
line-kv ::= "\"line\"" space ":" space line
line-rest ::= ( "," space patches-kv )? patches-rest
metadata ::= object
metadata-kv ::= "\"metadata\"" space ":" space metadata
new-string ::= "\"" new_string-guard-state-0 "\""
new-string-kv ::= "\"new_string\"" space ":" space new-string
new_string-guard-state-0 ::= [^"\\\x7F\x00-\x1F<] new_string-guard-state-0 | [\\] ( ["\\bfnrt] | "u" ( [0-9a-cA-Ce-fE-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]         | [dD] [0-7c-fC-F] [0-9a-fA-F] [0-9a-fA-F] ) ) new_string-guard-state-0 | ""
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
old-string ::= "\"" old_string-guard-state-0 "\""
old-string-kv ::= "\"old_string\"" space ":" space old-string
old_string-guard-state-0 ::= [^"\\\x7F\x00-\x1F<] old_string-guard-state-1 | [\\] ( ["\\bfnrt] | "u" ( [0-9a-cA-Ce-fE-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]         | [dD] [0-7c-fC-F] [0-9a-fA-F] [0-9a-fA-F] ) ) old_string-guard-state-1
old_string-guard-state-1 ::= [^"\\\x7F\x00-\x1F<] old_string-guard-state-1 | [\\] ( ["\\bfnrt] | "u" ( [0-9a-cA-Ce-fE-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]         | [dD] [0-7c-fC-F] [0-9a-fA-F] [0-9a-fA-F] ) ) old_string-guard-state-1 | ""
patches ::= "[" space (patches-item ("," space patches-item)*)? space "]"
patches-item ::= "{" space patches-item-old-string-kv "," space patches-item-new-string-kv ( "," space ( patches-item-replace-all-kv ) )? space "}"
patches-item-new-string ::= "\"" patches-item-new_string-guard-state-0 "\""
patches-item-new-string-kv ::= "\"new_string\"" space ":" space patches-item-new-string
patches-item-new_string-guard-state-0 ::= [^"\\\x7F\x00-\x1F<] patches-item-new_string-guard-state-0 | [\\] ( ["\\bfnrt] | "u" ( [0-9a-cA-Ce-fE-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]         | [dD] [0-7c-fC-F] [0-9a-fA-F] [0-9a-fA-F] ) ) patches-item-new_string-guard-state-0 | ""
patches-item-old-string ::= "\"" patches-item-old_string-guard-state-0 "\""
patches-item-old-string-kv ::= "\"old_string\"" space ":" space patches-item-old-string
patches-item-old_string-guard-state-0 ::= [^"\\\x7F\x00-\x1F<] patches-item-old_string-guard-state-0 | [\\] ( ["\\bfnrt] | "u" ( [0-9a-cA-Ce-fE-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]         | [dD] [0-7c-fC-F] [0-9a-fA-F] [0-9a-fA-F] ) ) patches-item-old_string-guard-state-0 | ""
patches-item-replace-all-kv ::= "\"replace_all\"" space ":" space boolean
patches-kv ::= "\"patches\"" space ":" space patches
patches-rest ::= ( "," space metadata-kv )?
replace-all-kv ::= "\"replace_all\"" space ":" space boolean
replace-all-rest ::= ( "," space description-kv )? description-rest
root ::= "{" space file-path-kv "," space old-string-kv "," space new-string-kv ( "," space ( replace-all-kv replace-all-rest | description-kv description-rest | line-kv line-rest | patches-kv patches-rest | metadata-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null
