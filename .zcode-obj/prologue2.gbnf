answer-root ::= answer-object
answer-value ::= answer-object | answer-array | answer-string | answer-number | ("true" | "false" | "null") answer-ws
answer-object ::= "{" answer-ws ( answer-string ":" answer-ws answer-value ("," answer-ws answer-string ":" answer-ws answer-value)* )? "}" answer-ws
answer-array ::= "[" answer-ws ( answer-value ("," answer-ws answer-value)* )? "]" answer-ws
answer-string ::= "\"" ( [^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F]{4}) )* "\"" answer-ws
answer-number ::= ("-"? ([0-9] | [1-9] [0-9]{0,15})) ("." [0-9]+)? ([eE] [-+]? [0-9] [1-9]{0,15})? answer-ws
answer-ws ::= | " " | "\n" [ \t]{0,20}
reason ::= [^<`] reason | "<" reason-1-0 | "`" reason-0-1 | ""
reason-1-0 ::= [^/`] reason | "/" reason-2-0 | "`" reason-0-1 | ""
reason-0-1 ::= [^<`] reason | "<" reason-1-0 | "`" reason-0-2 | ""
reason-2-0 ::= [^`t] reason | "`" reason-0-1 | "t" reason-3-0 | ""
reason-0-2 ::= [^<`] reason | "<" reason-1-0 | "`" reason-0-3 | ""
reason-3-0 ::= [^`h] reason | "`" reason-0-1 | "h" reason-4-0 | ""
reason-0-3 ::= [^<j] reason | "<" reason-1-0 | "j" reason-0-4 | ""
reason-4-0 ::= [^`i] reason | "`" reason-0-1 | "i" reason-5-0 | ""
reason-0-4 ::= [^<s] reason | "<" reason-1-0 | "s" reason-0-5 | ""
reason-5-0 ::= [^`n] reason | "`" reason-0-1 | "n" reason-6-0 | ""
reason-0-5 ::= [^<o] reason | "<" reason-1-0 | "o" reason-0-6 | ""
reason-6-0 ::= [^`k] reason | "`" reason-0-1 | "k" reason-7-0 | ""
reason-0-6 ::= [^<n] reason | "<" reason-1-0 | ""
reason-7-0 ::= [^>`] reason | "`" reason-0-1 | ""
ws ::= ( " " | "	" | "\n" )*
fenced ::= "```json" ws answer-root ws "```"
answer ::= ws ( fenced | answer-root )
root ::= reason "</think>\n" answer
