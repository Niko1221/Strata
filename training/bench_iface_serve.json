{
  "exe": "$STRATA_ENGINE_DIR/strata",
  "args": [
    "--pack",
    "$STRATA_DATA/packs/swift-iq3_xxs",
    "--native",
    "$STRATA_DATA/models/swift-IQ3_XXS/Swift-Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf",
    "--ple-gguf",
    "$STRATA_DATA/models/swift-IQ3_XXS/Swift-Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf",
    "--expert-cache",
    "auto",
    "--expert-profile",
    "$STRATA_ROOT/data/expert-profile.bin",
    "--prefill",
    "8192",
    "--spec",
    "4",
    "--max-context",
    "131072",
    "--kv",
    "auto",
    "--vram-reserve-mib",
    "700",
    "--serve",
    "--no-prefill-borrow",
    "--lora",
    "$STRATA_MEZO/examples/training/lora_hard_dpo.gguf"
  ],
  "cwd": "$STRATA_ENGINE_DIR",
  "log": "$STRATA_TRAIN/examples/training/bench_iface_serve.log",
  "tokenizer": "$STRATA_DATA/packs/swift-iq3_xxs/tokenizer",
  "model_name": "strata"
}