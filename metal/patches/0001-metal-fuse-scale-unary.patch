+// SCALE + UNARY (silu, sigmoid): the unary kernel computes the scaled value itself, with the same expression and
+// the same f32 rounding the SCALE kernel stores, so the result is bit-identical to the two kernels
+static bool ggml_metal_fusion_check_scale_unary(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(fusion);
+    GGML_UNUSED(gf);
+    GGML_UNUSED(node_idxs);
+    GGML_UNUSED(idx);
+    GGML_UNUSED(mode);
+
+    const ggml_tensor * scale = nodes[0];
+    const ggml_tensor * un    = nodes[1];
+
+    if (scale->op != GGML_OP_SCALE || un->op != GGML_OP_UNARY || un->src[0] != scale || un->src[1]) {
+        return false;
+    }
+
+    const ggml_unary_op uop = ggml_get_unary_op(un);
+    if (uop != GGML_UNARY_OP_SILU && uop != GGML_UNARY_OP_SIGMOID) {
+        return false;
+    }
+
+    if (scale->src[0]->type != GGML_TYPE_F32 || scale->type != GGML_TYPE_F32 || un->type != GGML_TYPE_F32) {
+        return false;
+    }
+
+    // the unary kernel picks flat indexing from its own source's (the SCALE output's) layout, and reads the SCALE's
+    // input with it: that input must be laid out the same way, so contiguous
+    if (!ggml_is_contiguous(scale->src[0]) || !ggml_are_same_shape(scale->src[0], un)) {
+        return false;
+    }
+
+    return true;
+}
