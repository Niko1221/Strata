    "text": "```python\nimport threading\nimport heapq\nimport time\nimport uuid\nfrom enum import Enum\nfrom typing import Any, Callable, Optional, Dict, List, Tuple\nimport unittest\n\n\nclass TaskStatus(Enum):\n    PENDING = \"pending\"\n    RUNNING = \"running\"\n    COMPLETED = \"completed\"\n    CANCELLED = \"cancelled\"\n    FAILED = \"failed\"\n    TIMEOUT = \"timeout\"\n\n\nclass Task:\n    \"\"\"Represents a task in the priority queue.\"\"\"\n\n    def __init__(self, func: Callable, args: tuple = (), kwargs: dict = None,\n                 priority: int = 0, timeout: Optional[float] = None):\n        self.id = str(uuid.uuid4())\n        self.func = func\n        self.args = args\n        self.kwargs = kwargs or {}\n        self.priority = priority\n        self.timeout = timeout\n        self.status = TaskStatus.PENDING\n        self.result = None\n        self.exception = None\n        self.created_at = time.time()\n        self.started_at = None\n        self.completed_at = None\n        self._lock = threading.Lock()\n        self._cancelled = False\n\n    def cancel(self) -> bool:\n        \"\"\"Attempt to cancel the task. Returns True if cancellation was successful.\"\"\"\n        with self._lock:\n            if self.status in (TaskStatus.PENDING, TaskStatus.RUNNING):\n                self._cancelled = True\n                if self.status == TaskStatus.PENDING:\n                    self.status = TaskStatus.CANCELLED\n                return True\n            return False\n\n    def is_cancelled(self) -> bool:\n        with self._lock:\n            return self._cancelled\n\n    def __lt__(self, other: 'Task') -> bool:\n        \"\"\"For heap comparison: lower priority value = higher priority.\n        If priorities are equal, earlier created tasks go first.\"\"\"\n        if self.priority != other.priority:\n            return self.priority < other.priority\n        return self.created_at < other.created_at\n\n\nclass PriorityTaskQueue:\n    \"\"\"Thread-safe priority task queue with cancellation and timeout support.\"\"\"\n\n    def __init__(self, num_workers: int = 1):\n        self._heap: List[Task] = []\n        self._lock = threading.Lock()\n        self._condition = threading.Condition(self._lock)\n        self._tasks: Dict[str, Task] = {}\n        self._running = True\n        self._workers: List[threading.Thread] = []\n        self._num_workers = num_workers\n        self._start_workers()\n\n    def _start_workers(self):\n        \"\"\"Start worker threads.\"\"\"\n        for i in range(self._num_workers):\n            worker = threading.Thread(target=self._worker_loop, name=f\"Worker-{i}\", daemon=True)\n            worker.start()\n            self._workers.append(worker)\n\n    def _worker_loop(self):\n        \"\"\"Main loop for worker threads.\"\"\"\n        while self._running:\n            task = None\n            with self._condition:\n                while self._running and not self._heap:\n                    self._condition.wait()\n                if not self._running:\n                    break\n                if self._heap:\n                    task = heapq.heappop(self._heap)\n                    # Check if task was cancelled while waiting\n                    if task.is_cancelled():\n                        continue\n                    task.status = TaskStatus.RUNNING\n                    task.started_at = time.time()\n\n            if task is None:\n                continue\n\n            # Execute the task\n            try:\n                # Check for timeout before execution\n                if task.timeout is not None:\n                    elapsed = time.time() - task.created_at\n                    if elapsed > task.timeout:\n                        task.status = TaskStatus.TIMEOUT\n                        task.completed_at = time.time()\n                        continue\n\n                # Run the function\n                result = task.func(*task.args, **task.kwargs)\n                with task._lock:\n                    if not task.is_cancelled():\n                        task.result = result\n                        task.status = TaskStatus.COMPLETED\n                    else:\n                        task.status = TaskStatus.CANCELLED\n            except Exception as e:\n                with task._lock:\n                    if not task.is_cancelled():\n                        task.exception = e\n                        task.status = TaskStatus.FAILED\n                    else:\n                        task.status = TaskStatus.CANCELLED\n            finally:\n                task.completed_at = time.time()\n\n    def submit(self, func: Callable, args: tuple = (), kwargs: dict = None,\n               priority: int = 0, timeout: Optional[float] = None) -> Task:\n        \"\"\"Submit a task to the queue.\n        \n        Args:\n            func: The callable to execute.\n            args: Positional arguments for the callable.\n            kwargs: Keyword arguments for the callable.\n",
