    "text": "```python\nimport threading\nimport heapq\nimport time\nimport uuid\nfrom typing import Any, Callable, Optional, Dict, List, Tuple\nfrom dataclasses import dataclass, field\nfrom enum import Enum\nfrom concurrent.futures import Future\n\n\nclass TaskStatus(Enum):\n    PENDING = \"pending\"\n    RUNNING = \"running\"\n    COMPLETED = \"completed\"\n    CANCELLED = \"cancelled\"\n    FAILED = \"failed\"\n    TIMED_OUT = \"timed_out\"\n\n\n@dataclass\nclass Task:\n    id: str\n    func: Callable[..., Any]\n    args: tuple\n    kwargs: dict\n    priority: int\n    timeout: Optional[float]\n    status: TaskStatus = TaskStatus.PENDING\n    result: Any = None\n    exception: Optional[Exception] = None\n    created_at: float = field(default_factory=time.time)\n    started_at: Optional[float] = None\n    finished_at: Optional[float] = None\n    _cancel_event: threading.Event = field(default_factory=threading.Event, repr=False)\n\n    def cancel(self) -> bool:\n        \"\"\"Request cancellation of the task. Returns True if cancellation was requested.\"\"\"\n        if self.status in (TaskStatus.PENDING, TaskStatus.RUNNING):\n            self._cancel_event.set()\n            return True\n        return False\n\n    def is_cancelled(self) -> bool:\n        return self._cancel_event.is_set()\n\n    def __lt__(self, other: 'Task') -> bool:\n        \"\"\"For heap comparison: lower priority value = higher priority.\n        If priorities are equal, earlier created_at wins.\"\"\"\n        if self.priority != other.priority:\n            return self.priority < other.priority\n        return self.created_at < other.created_at\n\n\nclass PriorityTaskQueue:\n    \"\"\"\n    A thread-safe priority task queue with support for cancellation and timeouts.\n    \n    Tasks are executed by worker threads. Higher priority tasks (lower priority number)\n    are executed first. Each task can have an optional timeout.\n    \"\"\"\n\n    def __init__(self, num_workers: int = 4):\n        self._lock = threading.Lock()\n        self._condition = threading.Condition(self._lock)\n        self._heap: List[Task] = []\n        self._tasks: Dict[str, Task] = {}\n        self._workers: List[threading.Thread] = []\n        self._shutdown = False\n        self._num_workers = num_workers\n        self._start_workers()\n\n    def _start_workers(self):\n        for i in range(self._num_workers):\n            worker = threading.Thread(target=self._worker_loop, name=f\"TaskWorker-{i}\", daemon=True)\n            worker.start()\n            self._workers.append(worker)\n\n    def submit(self, func: Callable[..., Any], *args, priority: int = 0, timeout: Optional[float] = None, **kwargs) -> str:\n        \"\"\"\n        Submit a task to the queue.\n        \n        Args:\n            func: The callable to execute.\n            *args: Positional arguments for func.\n            priority: Lower number = higher priority. Default is 0.\n            timeout: Optional timeout in seconds. If None, no timeout.\n            **kwargs: Keyword arguments for func.\n            \n        Returns:\n            The unique task ID.\n        \"\"\"\n        task_id = str(uuid.uuid4())\n        task = Task(\n            id=task_id,\n            func=func,\n            args=args,\n            kwargs=kwargs,\n            priority=priority,\n            timeout=timeout\n        )\n        \n        with self._lock:\n            if self._shutdown:\n                raise RuntimeError(\"Queue is shut down\")\n            heapq.heappush(self._heap, task)\n            self._tasks[task_id] = task\n            self._condition.notify()\n        \n        return task_id\n\n    def cancel(self, task_id: str) -> bool:\n        \"\"\"\n        Request cancellation of a task by ID.\n        \n        Args:\n            task_id: The ID of the task to cancel.\n            \n        Returns:\n            True if the task exists and cancellation was requested, False otherwise.\n        \"\"\"\n        with self._lock:\n            task = self._tasks.get(task_id)\n            if task is None:\n                return False\n            return task.cancel()\n\n    def get_status(self, task_id: str) -> Optional[TaskStatus]:\n        \"\"\"Get the current status of a task.\"\"\"\n        with self._lock:\n            task = self._tasks.get(task_id)\n            if task is None:\n                return None\n            return task.status\n\n    def get_result(self, task_id: str, timeout: Optional[float] = None) -> Any:\n       ",
