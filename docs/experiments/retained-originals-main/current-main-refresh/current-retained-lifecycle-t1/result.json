    "text": "```python\n\"\"\"\nThread-safe priority task queue with cancellation, timeouts, and deterministic tests.\n\"\"\"\n\nimport threading\nimport heapq\nimport time\nimport uuid\nfrom enum import Enum\nfrom typing import Any, Callable, Optional, List, Tuple\nfrom dataclasses import dataclass, field\nfrom concurrent.futures import Future\n\n\nclass TaskStatus(Enum):\n    PENDING = \"pending\"\n    RUNNING = \"running\"\n    COMPLETED = \"completed\"\n    CANCELLED = \"cancelled\"\n    FAILED = \"failed\"\n    TIMED_OUT = \"timed_out\"\n\n\n@dataclass(order=True)\nclass Task:\n    \"\"\"\n    A task with priority, callable, and metadata.\n    Lower priority value means higher priority.\n    \"\"\"\n    priority: int\n    task_id: str = field(compare=False)\n    func: Callable = field(compare=False)\n    args: tuple = field(compare=False, default=())\n    kwargs: dict = field(compare=False, default_factory=dict)\n    status: TaskStatus = field(compare=False, default=TaskStatus.PENDING)\n    result: Any = field(compare=False, default=None)\n    exception: Optional[Exception] = field(compare=False, default=None)\n    created_at: float = field(compare=False, default_factory=time.time)\n    started_at: Optional[float] = field(compare=False, default=None)\n    finished_at: Optional[float] = field(compare=False, default=None)\n    timeout: Optional[float] = field(compare=False, default=None)\n    _cancel_event: threading.Event = field(compare=False, default_factory=threading.Event, repr=False)\n\n    def cancel(self) -> bool:\n        \"\"\"Request cancellation of the task. Returns True if cancellation was requested.\"\"\"\n        if self.status in (TaskStatus.PENDING, TaskStatus.RUNNING):\n            self._cancel_event.set()\n            return True\n        return False\n\n    @property\n    def is_cancelled(self) -> bool:\n        return self._cancel_event.is_set()\n\n    def __post_init__(self):\n        if not self.task_id:\n            self.task_id = str(uuid.uuid4())\n\n\nclass PriorityTaskQueue:\n    \"\"\"\n    A thread-safe priority task queue that supports:\n    - Priority-based execution (lower number = higher priority)\n    - Task cancellation\n    - Task timeouts\n    - Deterministic behavior for testing\n    \"\"\"",
