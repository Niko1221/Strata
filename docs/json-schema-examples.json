  },
  {
    "name": "25-annotations",
    "schema": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "title": "Answer",
          "description": "A human-readable result.",
          "default": "ready",
          "examples": [
            "ready"
          ],
          "readOnly": true,
          "writeOnly": false,
          "deprecated": false,
          "$comment": "Annotations do not insert defaults or modify output."
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "sample": {
      "value": "ready"
