# Copy to .env next to the compose file you use. Every line is optional.
# STRATA_IMAGE=strata:0.2.20-cuda13    # only to use an image you built yourself (docker/build.sh); the default is the published ghcr.io/niko1221/strata image (or :latest-<flavor>)
# FAMILY=qwen                          # qwen, qwen36, hy4-flash, inkling-2-mini, unsloth, gyro, coder, swift, nvfp4
# MODEL=IQ3_XXS                        # e.g. IQ3_XXS (qwen), UD-Q4_K_XL (qwen36), SQ-64 (hy4-flash), SQ-10 / SQ-15 / SQ-20 (inkling-2-mini)
# MODEL_PATH=/models                   # .gguf, .strata, or .safetensors folder; mount with  - /srv/models/my-model:/models:ro
# CONTEXT=32k
# PARALLEL=2
# VISION=off
# TUNE=skip
# API_KEY=put-a-long-random-key-here        # openssl rand -hex 24
# STRATA_BIND=127.0.0.1                     # 0.0.0.0 = reachable from your network (then use a real API_KEY)
# STRATA_PORT=8080
# RENDER_GID=                               # AMD / Intel only: getent group render | cut -d: -f3
