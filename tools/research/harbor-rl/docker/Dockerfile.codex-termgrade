FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's|archive.ubuntu.com|mirrors.tuna.tsinghua.edu.cn|g; s|security.ubuntu.com|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true && \
    apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates curl wget git jq ripgrep fd-find tree vim less \
      build-essential pkg-config cmake sqlite3 unzip zip tar gzip xz-utils \
      python3 python3-pip python3-venv python3-dev procps net-tools iputils-ping \
    && rm -rf /var/lib/apt/lists/* && \
    pip3 install --break-system-packages -i https://pypi.tuna.tsinghua.edu.cn/simple pytest requests pyyaml toml && \
    curl -fsSL https://npmmirror.com/mirrors/node/v22.14.0/node-v22.14.0-linux-x64.tar.xz | tar -xJ -C /usr/local --strip-components=1 && \
    npm install -g @openai/codex --registry=https://registry.npmmirror.com && \
    node -v && codex --version && python3 --version && pytest --version
RUN python3 -m venv /opt/verifier_venv && \
    /opt/verifier_venv/bin/pip install -i https://pypi.tuna.tsinghua.edu.cn/simple pytest==8.4.1 pytest-json-ctrf && \
    /opt/verifier_venv/bin/pytest --version
ENV PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED
WORKDIR /app
